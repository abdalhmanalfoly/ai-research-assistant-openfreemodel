# ======================================================================
# AI Research Assistant — environment template. PLACEHOLDERS ONLY.
# Copy to .env (never commit .env). Variables marked [USED] are read by app/core/config.py.
# Variables marked [NOT USED YET] are reserved for future Supabase Storage/Auth work and are ignored.
# Removed local-inference and OpenAI-API settings (OLLAMA_*, OPENAI_API_KEY, OPENAI_BASE_URL, ...) are ignored;
# the app logs a warning naming any that are still set.
# ======================================================================

APP_ENV=development                 # [USED]
LOG_LEVEL=INFO                      # [USED]

# --- Database [USED] ---------------------------------------------------
# Local Docker Postgres (docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://research:research@localhost:5432/research
#
# Supabase (Dashboard -> Connect). Driver prefix MUST be postgresql+psycopg://
# Percent-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
#   Direct (IPv6; migrations + long-lived backend):
#     postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
#   Session pooler (IPv4 networks; supports prepared statements; recommended on Windows/home networks):
#     postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
#   Transaction pooler (port 6543): also set DB_DISABLE_PREPARED_STATEMENTS=true
DATABASE_URL=YOUR_SUPABASE_POSTGRES_CONNECTION_STRING
DB_DISABLE_PREPARED_STATEMENTS=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- OpenRouter [USED]: ONE key for answer generation AND embeddings -----------
# Backend-only secret. Put it in your real .env (git-ignored) or the server's environment. Never in the frontend,
# Git, screenshots, logs or chat. Both configured models are FREE (published pricing 0), but free tiers have rate
# limits and can be temporarily unavailable. Create the key at https://openrouter.ai/keys (no billing/credits needed).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ALLOW_CUSTOM_BASE_URL=false  # keep false: a non-OpenRouter host would receive your key
OPENROUTER_MAX_RETRIES=2            # SDK retries for connection errors / 429 / 5xx with backoff (0-5; never infinite)

# --- Answer generation [USED] -------------------------------------------
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1000

# --- Embeddings [USED] ----------------------------------------------------
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
# MUST equal the vector(N) column. Migration 0005 creates the column from this value, so set it BEFORE
# `alembic upgrade head`. 2048 is the model's native output size but EXCEEDS the pgvector HNSW index limit
# (2000): the column is created WITHOUT an index (full-scan cosine search, fine for small/medium corpora).
# 1024 requests the model's documented 128..2048 `dimensions` range and keeps an HNSW index possible.
# embedding_dim is validated against every real response (mismatch = loud error, never silent truncation).
EMBEDDING_DIMENSIONS=2048
EMBEDDING_BATCH_SIZE=64             # texts per embeddings request
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_INPUT_CHARS=24000     # longer texts are rejected before any API call</think>Ah wait — that edit was to the wrong target (I addressed `.env.example` but the earlier read shows the same text exists in both files). Let me verify which file was edited and complete each section properly:<tool_call>edit<arg_key>newString</arg_key><arg_value># --- OpenRouter [USED]: ONE key for answer generation AND embeddings -----------
# Backend-only secret. Put it in your real .env (git-ignored) or the server's environment. Never in the frontend,
# Git, screenshots, logs or chat. Both configured models are FREE (published pricing 0), but free tiers have rate
# limits and can be temporarily unavailable. Create the key at https://openrouter.ai/keys (no billing/credits needed).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ALLOW_CUSTOM_BASE_URL=false  # keep false: a non-OpenRouter host would receive your key
OPENROUTER_MAX_RETRIES=2            # SDK retries for connection errors / 429 / 5xx with backoff (0-5; never infinite)

# --- Answer generation [USED] -------------------------------------------
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1000

# --- Embeddings [USED] ----------------------------------------------------
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
# MUST equal the vector(N) column. Migration 0005 creates the column from this value, so set it BEFORE
# `alembic upgrade head`. 2048 is the model's native output size but EXCEEDS the pgvector HNSW index limit
# (2000): the column is created WITHOUT an index (full-scan cosine search, fine for small/medium corpora).
# 1024 requests the model's documented 128..2048 `dimensions` range and keeps an HNSW index possible.
# Every returned vector is validated against this value (mismatch = loud error, never silent truncation).
EMBEDDING_DIMENSIONS=2048
EMBEDDING_BATCH_SIZE=64             # texts per embeddings request
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_INPUT_CHARS=24000     # longer texts are rejected before any API call

# --- Retrieval [USED] ---------------------------------------------------
RETRIEVAL_TOP_K=5
# UNCALIBRATED for nvidia/nemotron-3.5-embed-1b:free (cosine scores differ per embedding model; 0.45 was for BGE and
# 0.30 for OpenAI). First index papers, then run: python -m scripts.calibrate_threshold questions.json
RETRIEVAL_THRESHOLD=0.30
EVIDENCE_BUDGET_CHARS=              # empty = 12000 characters of evidence per question
CHUNK_MAX_CHARS=1200

# --- PDFs [USED] --------------------------------------------------------
CORS_ORIGINS=                       # only needed if the frontend is served from another origin, e.g. http://localhost:5500
SERVE_FRONTEND=true                 # serve ./frontend at http://localhost:8000/
MAX_PDF_MB=50
STORAGE_DIR=./data/storage          # local disk today; Supabase Storage is NOT implemented

# --- OCR for scanned PDFs [USED] ---------------------------------------
OCR_ENABLED=true
OCR_PROVIDER=auto                   # auto | rapidocr | tesseract | none
OCR_LANGUAGE=eng                    # Tesseract only (e.g. eng, ara, eng+ara); RapidOCR uses its bundled model
OCR_DPI=200                         # page render resolution for OCR; higher = slower, usually better
OCR_MIN_PAGE_CHARS=25               # pages with less extractable text are treated as scanned
OCR_MAX_PAGES=0                     # 0 = no limit; guard against very large scanned documents

# --- Supabase [NOT USED YET] -------------------------------------------
# Backend-only. Never put the secret key in a frontend, Git, screenshots or chat.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY       # safe for browsers ONLY because RLS protects the tables
# SUPABASE_SECRET_KEY=YOUR_SECRET_KEY                 # bypasses RLS. Server-side only.
# SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
